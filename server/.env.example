# 관리자 화면 비밀번호 (필수, 반드시 변경하세요)
ADMIN_PASSWORD=change-me

# 세션 서명용 시크릿 (필수, 긴 랜덤 문자열)
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000

# Cloudflare Turnstile (공개 배포 전 반드시 설정)
# https://dash.cloudflare.com → Turnstile → 사이트 추가 후 발급
# 설정하지 않으면 캡차가 꺼진 채로 동작합니다.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Discord 알림 (선택)
# 서버 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
# 비워두면 알림이 비활성화됩니다.
DISCORD_WEBHOOK_URL=
# 알림에 표시할 관리자 화면 주소 (예: https://api.example.com/admin/)
ADMIN_PUBLIC_URL=

# data.js 경로 (기본: ../data.js)
# DATA_JS_PATH=/path/to/data.js

# 승인 시 Git 커밋/푸시 여부
GIT_AUTO_COMMIT=false

# GitHub push 자동 배포 웹훅 (선택)
# 저장소 Settings → Webhooks 에서 설정한 Secret 과 같은 값을 넣으세요.
# 비워두면 /api/deploy 엔드포인트 자체가 등록되지 않습니다.
GITHUB_WEBHOOK_SECRET=
# 배포 대상 브랜치 (기본 main)
DEPLOY_BRANCH=main

# ── 후속작 리더보드 (선택) ────────────────────────────────
# 'NowLoading이 끝나지 않아' 리더보드를 같은 서버에서 받으려면
# 아래 두 줄을 채우세요. 비워 두면 기존과 완전히 동일하게 동작합니다.
# 리더보드 저장소·Netlify 배포는 별도로 두고, 제출 서버만 공용입니다.
# NOWLOADING_DATA_JS_PATH=/home/ubuntu/nowloading_leaderboard/data.js
# NOWLOADING_REPO_DIR=/home/ubuntu/nowloading_leaderboard
